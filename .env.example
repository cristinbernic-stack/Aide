# Copiază în .env și completează. Nu comite .env.

# --- RunPod Serverless (vLLM) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Se construiește din ENDPOINT_ID; nu modifica decât dacă schimbi provider-ul.
RUNPOD_API_BASE=https://api.runpod.ai/v2/${RUNPOD_ENDPOINT_ID}/openai/v1
# Numele modelului exact așa cum l-a încărcat vLLM
MODEL_NAME=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8

# --- LiteLLM ---
# genereaza: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-schimba-ma
# Buget lunar hard in USD pentru toate apelurile prin LiteLLM
LITELLM_MAX_BUDGET=55

# --- Postgres (LiteLLM + Open WebUI) ---
POSTGRES_USER=aide
POSTGRES_PASSWORD=schimba-ma
POSTGRES_DB=aide

# --- Runner (Issue -> PR) ---
# Fine-grained PAT pe repo-ul tinta: Contents RW, Pull requests RW, Issues RW
GITHUB_TOKEN=
# owner/repo al proiectului pe care lucreaza agentul (ex: cristinbernic-stack/nexus)
TARGET_REPO=
TARGET_BRANCH=main
# Comanda de test rulata de aider dupa fiecare modificare (goala = fara teste)
TEST_CMD=
# Limite per task
TASK_TIMEOUT_MIN=30
POLL_INTERVAL_SEC=60
GIT_AUTHOR_NAME=Aide Agent
GIT_AUTHOR_EMAIL=aide@users.noreply.github.com

# --- Telegram (notificari) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Open WebUI ---
WEBUI_SECRET_KEY=schimba-ma
